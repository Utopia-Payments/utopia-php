{
    "name": "utopia-payments/utopia-php",
    "description": "Official PHP library for the Utopia Payments API: hosted checkout, subscriptions and signed webhooks.",
    "type": "library",
    "license": "MIT",
    "keywords": ["utopia", "payments", "checkout", "subscriptions", "webhooks", "api"],
    "homepage": "https://utopia-payments.com/docs/",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Utopia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Utopia\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
